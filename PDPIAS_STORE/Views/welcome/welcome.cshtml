    <!-- Hero Section -->
    <section class="hero" id="home">
        <div id="heroCarousel"
             class="carousel slide carousel-fade"
             data-bs-ride="carousel"
             data-bs-interval="5000">
            <div class="carousel-indicators">
                <button type="button"
                        data-bs-target="#heroCarousel"
                        data-bs-slide-to="0"
                        class="active"></button>
                <button type="button"
                        data-bs-target="#heroCarousel"
                        data-bs-slide-to="1"></button>
                <button type="button"
                        data-bs-target="#heroCarousel"
                        data-bs-slide-to="2"></button>
            </div>

            <div class="carousel-inner">
                <!-- Slide 1 -->
                <div class="carousel-item active"
                     style="background-image: url('../../assets/chem2.png')">
                    <div class="hero-content animate__animated animate__fadeInLeft">
                        <h2>Manage Chemicals Efficiently</h2>
                        <p>
                            Streamline your chemical inventory management with our
                            comprehensive tracking system that ensures accuracy and saves
                            time.
                        </p>
                        <a href="#features" class="btn btn-hero">Explore Features</a>
                    </div>
                </div>

                <!-- Slide 2 -->
                <div class="carousel-item" style="background-image: url('../../assets/chem1.jpg') ">
                    <div class="hero-content animate__animated animate__fadeInLeft">
                        <h2>Secure Chemical Handling</h2>
                        <p>
                            Ensure safety compliance with our system that tracks handling
                            procedures and maintains detailed safety records.
                        </p>
                        <a href="#about" class="btn btn-hero">Learn More</a>
                    </div>
                </div>

                <!-- Slide 3 -->
                <div class="carousel-item" style="background-image: url('../../assets/second.jpg') ">
                    <div class="hero-content animate__animated animate__fadeInLeft">
                        <h2>Comprehensive Reporting</h2>
                        <p>
                            Generate detailed reports on chemical usage, inventory levels,
                            and compliance documentation with just a few clicks.
                        </p>
                        <a href="#" class="btn btn-hero">View Demo</a>
                    </div>
                </div>
            </div>

            <button class="carousel-control-prev"
                    type="button"
                    data-bs-target="#heroCarousel"
                    data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next"
                    type="button"
                    data-bs-target="#heroCarousel"
                    data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>

            <div class="scroll-down">
                <i class="fas fa-chevron-down"></i>
            </div>
        </div>
