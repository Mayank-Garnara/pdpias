                            <div class="role-stats">
                                <div class="stat-item">
                                    <span class="stat-number">3+</span>
                                    <span class="stat-label">Daily Tasks</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-number">60%</span>
                                    <span class="stat-label">Access Level</span>
                                </div>
                            </div>
                            
                        </div>
                    </div>
                </div>
            </div>

