    <!-- System Features Highlights Section -->

    <section class="features-section" id="features">
        <div class="container">
            <div class="section-intro text-center mb-5">
                <span class="section-badge">Core Capabilities</span>
                <h2 class="section-title">Powerful Inventory Management Features</h2>
                <p class="section-subtitle">
                    Streamline your lab operations with our comprehensive toolkit
                </p>
            </div>

            <div class="features-grid">
                <!-- Feature 1 -->
                <div class="feature-card">
                    <div class="feature-header">
                        <div class="feature-icon">
                            <i class="fas fa-vial"></i>
                        </div>
                        <h3>Chemical Management</h3>
                    </div>
                    <div class="feature-body">
                        <p>
                            Complete lifecycle tracking for all laboratory chemicals with
                            automated alerts
                        </p>
                        <ul class="feature-list">
                            <li><i class="fas fa-check"></i> Real-time inventory levels</li>
                            <li><i class="fas fa-check"></i> Expiration monitoring</li>
                            <li><i class="fas fa-check"></i> Safety data integration</li>
                        </ul>
                    </div>
                    <div class="feature-footer">
                        <a href="#" class="feature-link">
                            Learn more <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                    <div class="feature-highlight"></div>
                </div>

                <!-- Feature 2 -->
                <div class="feature-card featured">
                    <div class="feature-badge">Most Popular</div>
                    <div class="feature-header">
                        <div class="feature-icon">
                            <i class="fas fa-glass-whiskey"></i>
                        </div>
                        <h3>Equipment Tracking</h3>
                    </div>
                    <div class="feature-body">
                        <p>Comprehensive glassware and instrument management system</p>
                        <ul class="feature-list">
                            <li><i class="fas fa-check"></i> Condition monitoring</li>
                            <li><i class="fas fa-check"></i> Maintenance scheduling</li>
                            <li><i class="fas fa-check"></i> Calibration records</li>
                        </ul>
                    </div>
                    <div class="feature-footer">
                        <a href="#" class="feature-link">
                            Learn more <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                    <div class="feature-highlight"></div>
                </div>

                <!-- Feature 3 -->
                <div class="feature-card">
                    <div class="feature-header">
                        <div class="feature-icon">
                            <i class="fas fa-clipboard-list"></i>
                        </div>
                        <h3>Audit Logs</h3>
                    </div>
                    <div class="feature-body">
                        <p>Complete transaction history and compliance documentation</p>
                        <ul class="feature-list">
                            <li><i class="fas fa-check"></i> User activity tracking</li>
                            <li><i class="fas fa-check"></i> Exportable reports</li>
                            <li><i class="fas fa-check"></i> Regulatory compliance</li>
                        </ul>
                    </div>
                    <div class="feature-footer">
                        <a href="#" class="feature-link">
                            Learn more <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                    <div class="feature-highlight"></div>
                </div>

                <!-- Feature 4 -->
                <div class="feature-card">
                    <div class="feature-header">
                        <div class="feature-icon">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <h3>Hazard Control</h3>
                    </div>
                    <div class="feature-body">
                        <p>
                            Specialized management for dangerous and controlled substances
                        </p>
                        <ul class="feature-list">
                            <li><i class="fas fa-check"></i> Restricted access</li>
                            <li><i class="fas fa-check"></i> Emergency protocols</li>
                            <li><i class="fas fa-check"></i> Disposal tracking</li>
                        </ul>
                    </div>
                    <div class="feature-footer">
                        <a href="#" class="feature-link">
                            Learn more <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                    <div class="feature-highlight"></div>
                </div>
            </div>

