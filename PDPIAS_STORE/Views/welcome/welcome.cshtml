    <!-- About Section -->
    <section class="about" id="about">
        <div class="container about-container">
            <h2 class="about-heading">About PDPias Store</h2>
            <div class="about-card">
                <p class="about-description">
                    PDPias Store is a comprehensive chemical management platform
                    designed for educational and research laboratories. Our system
                    provides centralized control over chemicals, glassware, and lab
                    inventory with specialized interfaces for lab technicians,
                    department heads, store managers, and institutional administrators.
                </p>

                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-vial"></i>
                        </div>
                        <h3 class="feature-title">Chemical Tracking</h3>
                        <p class="feature-desc">
                            Real-time tracking of chemical inventory with expiry alerts and
                            safety data
                        </p>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-clipboard-check"></i>
                        </div>
                        <h3 class="feature-title">Compliance</h3>
                        <p class="feature-desc">
                            Maintain regulatory compliance with automated documentation
                        </p>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <h3 class="feature-title">Reporting</h3>
                        <p class="feature-desc">
                            Generate detailed usage reports and analytics
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Roles & Responsibilities Section -->
    <!-- Interactive Roles Section -->
    <section class="roles-section py-5 position-relative" id="roles">
        <!-- Animated background elements -->
        <div class="role-shape role-shape-1"></div>
        <div class="role-shape role-shape-2"></div>

        <div class="container position-relative">
            <!-- Section Header with Interactive Filter -->
            <div class="section-header text-center mb-5">
                <h2 class="section-title animate__animated animate__fadeInDown">
                    Role-Based Access Control
                </h2>
                <p class="section-subtitle animate__animated animate__fadeIn animate__delay-1s">
                    Customized interfaces with specific permissions and capabilities
                </p>

                <div class="role-filter d-flex justify-content-center mb-4 animate__animated animate__fadeIn animate__delay-1s">
                    <button class="btn btn-filter active" data-filter="all">
                        All Roles
                    </button>
                    <button class="btn btn-filter" data-filter="primary">
                        Primary Users
                    </button>
                    <button class="btn btn-filter" data-filter="admin">
                        Administrators
                    </button>
                    <button class="btn btn-filter" data-filter="exec">
                        Executives
                    </button>
                </div>
            </div>

            <!-- Role Cards Grid -->
            <div class="row g-4 role-grid">
                <!-- Lab Technician Card -->
                <div class="col-lg-3 col-md-6" data-category="primary">
                    <div class="role-card h-100">
                        <div class="role-badge bg-primary">Primary User</div>
                        <div class="role-icon">
                            <i class="fas fa-vial"></i>
                            <div class="icon-circle"></div>
                        </div>
                        <div class="card-body text-center">
                            <h3 class="role-title">Lab Technicians</h3>
                            <div class="role-percentage">
                                <div class="progress-circle" data-percent="85">
                                    <svg class="progress-circle-svg" viewBox="0 0 36 36">
                                        <path class="progress-circle-track"
                                              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                        <path class="progress-circle-fill"
                                              stroke-dasharray="85, 100"
                                              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                    </svg>
                                    <span class="progress-text">85%</span>
                                </div>
                                <span class="progress-label">System Usage</span>
                            </div>
                            <p class="role-description">
                                Daily chemical management with full inventory access and
                                safety compliance tracking
                            </p>
                            <div class="role-stats">
                                <div class="stat-item">
                                    <span class="stat-number">12+</span>
                                    <span class="stat-label">Daily Tasks</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-number">100%</span>
                                    <span class="stat-label">Access Level</span>
                                </div>
                            </div>
                            
                        </div>
                    </div>
                </div>

                <!-- Department Head Card -->
                <div class="col-lg-3 col-md-6" data-category="admin">
                    <div class="role-card h-100">
                        <div class="role-badge bg-info">Department Level</div>
                        <div class="role-icon">
                            <i class="fas fa-user-tie"></i>
                            <div class="icon-circle"></div>
                        </div>
                        <div class="card-body text-center">
                            <h3 class="role-title">Department Heads</h3>
                            <div class="role-percentage">
                                <div class="progress-circle" data-percent="65">
                                    <svg class="progress-circle-svg" viewBox="0 0 36 36">
                                        <path class="progress-circle-track"
                                              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                        <path class="progress-circle-fill"
                                              stroke-dasharray="65, 100"
                                              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                    </svg>
                                    <span class="progress-text">65%</span>
                                </div>
                                <span class="progress-label">System Usage</span>
                            </div>
                            <p class="role-description">
                                Analytical oversight with approval workflows and
                                department-level reporting
                            </p>
                            <div class="role-stats">
                                <div class="stat-item">
                                    <span class="stat-number">5+</span>
                                    <span class="stat-label">Daily Tasks</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-number">80%</span>
                                    <span class="stat-label">Access Level</span>
                                </div>
                            </div>
                            
                        </div>
                    </div>
                </div>

                <!-- Store Manager Card -->
                <div class="col-lg-3 col-md-6" data-category="admin">
                    <div class="role-card h-100">
                        <div class="role-badge bg-warning">Administrator</div>
                        <div class="role-icon">
                            <i class="fas fa-warehouse"></i>
                            <div class="icon-circle"></div>
                        </div>
                        <div class="card-body text-center">
                            <h3 class="role-title">Store Managers</h3>
                            <div class="role-percentage">
                                <div class="progress-circle" data-percent="95">
                                    <svg class="progress-circle-svg" viewBox="0 0 36 36">
                                        <path class="progress-circle-track"
                                              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                        <path class="progress-circle-fill"
                                              stroke-dasharray="95, 100"
                                              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                    </svg>
                                    <span class="progress-text">95%</span>
                                </div>
                                <span class="progress-label">System Usage</span>
                            </div>
                            <p class="role-description">
                                Complete inventory control with procurement and supplier
