
@{
    Layout = "~/VieWs/Shared/principal_dashboard.cshtml";
    ViewBag.Title = "GlasswareTracking";
}

<main class="main-content" id="">
    <section id="glassware-tracking-section"
             class="content-section">
        <div class="page-header">
            <h1 class="page-title">Glassware Tracking</h1>
            <div>
                <button class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-download me-1"></i> Export
                </button>
            </div>
        </div>

        <p class="page-description">
            Track all glassware items across departments with detailed usage
            information.
        </p>

        <div class="card">
            <div class="card-header">
                <span>Department-wise Glassware Tracking</span>
                <div class="dropdown d-inline-block">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown">
                        All Departments
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#">All Departments</a></li>
                        <li><a class="dropdown-item" href="#">Chemistry</a></li>
                        <li><a class="dropdown-item" href="#">Physics</a></li>
                        <li><a class="dropdown-item" href="#">Biology</a></li>
                        <li><a class="dropdown-item" href="#">Research Lab</a></li>
                    </ul>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Glassware Item</th>
                                <th>Department</th>
                                <th>Total Quantity</th>
                                <th>Issued</th>
                                <th>Remaining</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Beaker 250ml</td>
                                <td>Chemistry</td>
                                <td>50</td>
                                <td>45</td>
                                <td>5</td>
                                <td><span class="badge bg-danger">Critical</span></td>
                            </tr>
                            <tr>
                                <td>Test Tubes</td>
                                <td>Physics</td>
                                <td>100</td>
                                <td>60</td>
                                <td>40</td>
                                <td><span class="badge bg-success">In Stock</span></td>
                            </tr>
                            <tr>
                                <td>Flask 500ml</td>
                                <td>Biology</td>
                                <td>30</td>
                                <td>25</td>
                                <td>5</td>
                                <td><span class="badge bg-warning">Low Stock</span></td>
                            </tr>
                            <tr>
                                <td>Pipettes</td>
                                <td>Research Lab</td>
                                <td>40</td>
                                <td>20</td>
                                <td>20</td>
                                <td><span class="badge bg-success">In Stock</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
 </main>
