@model PDPIAS_STORE.Models.Pricipal.UserManagementViewModel

@{
    Layout = "~/VieWs/Shared/principal_dashboard.cshtml";

    ViewBag.Title = "UserManagement";
}

<main class="main-content" id="mainContent">
    <section id="user-management-section"
             class="content-section">
        <div class="page-header">
            <h1 class="page-title">User Management</h1>
            <div>
                <button class="btn btn-sm btn-outline-primary me-2">
                    <i class="bi bi-download me-1"></i> Export
                </button>
                <button class="btn btn-sm btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#addUserModal">
                    <i class="bi bi-person-plus me-1"></i> Add User
                </button>
            </div>
        </div>

        <p class="page-description">
            Manage all users with access to the PDPias Chemical Management System.
        </p>

        <div class="card">
            <div class="card-header">
                <span>System Users</span>
                <div class="input-group w-25">
                    <input type="text"
                           class="form-control form-control-sm"
                           placeholder="Search users..." />
                    <button class="btn btn-sm btn-outline-secondary" type="button">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>User ID</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Department</th>
                                <th>Last Login</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>


                            @foreach (var item in Model.AllRequests)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.Id</td>
                                    <td>@item.Name</td>
                                    <td><span class="badge bg-primary">@item.Role</span></td>
                                    <td>@item.Department</td>
                                    <td>10-Apr-2025 09:15</td>
                                    <td><span class="badge bg-success">@item.Stauts</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary me-1">
                                            View
                                        </button>
                                       
                                    </td>
                                </tr>
                            }

                            <tr>
                                <td>USER-001</td>
                                <td>Dr. Kavit Bokarvadiya</td>
                                <td>principal@pdpias.edu</td>
                                <td><span class="badge bg-primary">Principal</span></td>
                                <td>All</td>
                                <td>10-Apr-2025 09:15</td>
                                <td><span class="badge bg-success">Active</span></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1">
                                        View
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td>USER-002</td>
                                <td>Dr. Smith</td>
                                <td>smith@chemistry.edu</td>
                                <td><span class="badge bg-info">HOD</span></td>
                                <td>Chemistry</td>
                                <td>09-Apr-2025 14:30</td>
                                <td><span class="badge bg-success">Active</span></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1">
                                        View
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td>USER-003</td>
                                <td>Lab Tech 1</td>
                                <td>labtech1@physics.edu</td>
                                <td><span class="badge bg-secondary">Technician</span></td>
                                <td>Physics</td>
                                <td>08-Apr-2025 11:45</td>
                                <td><span class="badge bg-success">Active</span></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1">
                                        View
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td>USER-004</td>
                                <td>Research Head</td>
                                <td>research@lab.edu</td>
                                <td><span class="badge bg-warning">Researcher</span></td>
                                <td>Research Lab</td>
                                <td>10-Apr-2025 10:20</td>
                                <td><span class="badge bg-success">Active</span></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1">
                                        View
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</main>

