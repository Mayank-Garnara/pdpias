@model PDPIAS_STORE.Models.Pricipal.UserManagementViewModel

@{
    Layout = "~/VieWs/Shared/principal_dashboard.cshtml";

    ViewBag.Title = "UserManagement";
}

<main class="main-content" id="mainContent">
    <section id="user-management-section"
             class="content-section">
        <div class="page-header">
            <h1 class="page-title">User Management</h1>
        </div>

        <p class="page-description">
            Manage all users with access to the PDPIAS Chemical Management System.
        </p>

        <div class="card">
            
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Department</th>
                                <th>Registration at</th>
                                
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.AllRequests)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.Email</td>
                                    <td><span class="badge bg-primary">@item.Role</span></td>
                                    <td>@item.Department</td>
                                    <td>10-Apr-2025 09:15</td>
                                    <td>
                                        @if (item.Stauts == "Pending")
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary me-1"
                                                    onclick="processUser('@item.Id', '@item.Role', 1)">
                                                <i class="bi bi-check-circle"></i> Approve
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="processUser('@item.Id', '@item.Role', 2)">
                                                <i class="bi bi-x-circle"></i> Block
                                            </button>
                                        }
                                        else if (item.Stauts == "Approved")
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="processUser('@item.Id', '@item.Role', 2)">
                                                <i class="bi bi-x-circle"></i> Block
                                            </button>
                                        }
                                        else if (item.Stauts == "Blocked")
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary me-1"
                                                    onclick="processUser('@item.Id', '@item.Role', 1)">
                                                <i class="bi bi-check-circle"></i> Unblock/Approve
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</main>

