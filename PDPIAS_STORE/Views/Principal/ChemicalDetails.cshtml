
@{
    Layout = "~/VieWs/Shared/principal_dashboard.cshtml";
    ViewBag.Title = "ChemicalDetails";
}

<main class="main-content" id="mainContent">
    <section id="chemical-details-section"
             class="content-section">
        <div class="page-header">
            <h1 class="page-title">Chemical Details</h1>
            <div>
                <button class="btn btn-sm btn-outline-primary me-2">
                    <i class="bi bi-download me-1"></i> Export
                </button>
                <button class="btn btn-sm btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#addChemicalModal">
                    <i class="bi bi-plus-circle me-1"></i> Add Chemical
                </button>
            </div>
        </div>

        <p class="page-description">
            View and manage detailed information about all chemicals in the
            inventory.
        </p>

        <div class="card">
            <div class="card-header">
                <span>Chemical Inventory</span>
                <div class="input-group w-25">
                    <input type="text"
                           class="form-control form-control-sm"
                           placeholder="Search chemicals..." />
                    <button class="btn btn-sm btn-outline-secondary" type="button">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Chemical ID</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Quantity</th>
                                <th>Location</th>
                                <th>Expiry Date</th>
                                <th>Safety Level</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>CHEM-001</td>
                                <td>Sodium Hydroxide</td>
                                <td>Base</td>
                                <td>500 ml</td>
                                <td>Chemistry Lab A1</td>
                                <td>15-Dec-2025</td>
                                <td><span class="badge bg-danger">Hazardous</span></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1">
                                        View
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td>CHEM-002</td>
                                <td>Hydrochloric Acid</td>
                                <td>Acid</td>
                                <td>1 L</td>
                                <td>Chemistry Lab B2</td>
                                <td>20-Nov-2025</td>
                                <td><span class="badge bg-danger">Hazardous</span></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1">
                                        View
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td>CHEM-003</td>
                                <td>Ethanol</td>
                                <td>Solvent</td>
                                <td>2 L</td>
                                <td>Biology Lab C3</td>
                                <td>30-Sep-2025</td>
                                <td><span class="badge bg-warning">Flammable</span></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1">
                                        View
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td>CHEM-004</td>
                                <td>Acetone</td>
                                <td>Solvent</td>
                                <td>1.5 L</td>
                                <td>Research Lab D4</td>
                                <td>15-Oct-2025</td>
                                <td><span class="badge bg-warning">Flammable</span></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1">
                                        View
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</main>

