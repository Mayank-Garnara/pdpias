
@{
    Layout = "~/VieWs/Shared/principal_dashboard.cshtml";
    ViewBag.Title = "GlasswareDetails";
}

<main class="main-content" id="mainContent">
    <section id="glassware-details-section"
             class="content-section">
        <div class="page-header">
            <h1 class="page-title">Glassware Details</h1>
            <div>
                <button class="btn btn-sm btn-outline-primary me-2">
                    <i class="bi bi-download me-1"></i> Export
                </button>
                <button class="btn btn-sm btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#addGlasswareModal">
                    <i class="bi bi-plus-circle me-1"></i> Add Glassware
                </button>
            </div>
        </div>

        <p class="page-description">
            View and manage detailed information about all glassware in the
            inventory.
        </p>

        <div class="card">
            <div class="card-header">
                <span>Glassware Inventory</span>
                <div class="input-group w-25">
                    <input type="text"
                           class="form-control form-control-sm"
                           placeholder="Search glassware..." />
                    <button class="btn btn-sm btn-outline-secondary" type="button">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Glassware ID</th>
                                <th>Name</th>
                                <th>Type</th>
                                <th>Quantity</th>
                                <th>Location</th>
                                <th>Condition</th>
                                <th>Last Checked</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>GLASS-001</td>
                                <td>Beaker 250ml</td>
                                <td>Beaker</td>
                                <td>50</td>
                                <td>Chemistry Lab A1</td>
                                <td><span class="badge bg-success">Good</span></td>
                                <td>05-Apr-2025</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1">
                                        View
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td>GLASS-002</td>
                                <td>Test Tubes</td>
                                <td>Tube</td>
                                <td>100</td>
                                <td>Physics Lab B2</td>
                                <td><span class="badge bg-success">Good</span></td>
                                <td>03-Apr-2025</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1">
                                        View
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td>GLASS-003</td>
                                <td>Flask 500ml</td>
                                <td>Flask</td>
                                <td>30</td>
                                <td>Biology Lab C3</td>
                                <td><span class="badge bg-warning">Needs Check</span></td>
                                <td>01-Apr-2025</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1">
                                        View
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td>GLASS-004</td>
                                <td>Pipettes</td>
                                <td>Measuring</td>
                                <td>40</td>
                                <td>Research Lab D4</td>
                                <td><span class="badge bg-success">Good</span></td>
                                <td>02-Apr-2025</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1">
                                        View
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
    </main>

