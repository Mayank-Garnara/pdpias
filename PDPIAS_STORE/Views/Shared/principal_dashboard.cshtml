<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PDPias - Principal Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/chart.js@3.7.1/dist/chart.min.css" />
    @*<link rel="stylesheet" href="style.css" />*@
    <link rel="stylesheet" href="~/Style/StyleSheet1.css" />
</head>
<body>
    <!-- Header Section -->
    <header class="custom-header">
        <div class="d-flex align-items-center">
            <!-- Mobile Menu Toggle Button -->
            <button class="mobile-menu-toggle"
                    id="menuToggle"
                    aria-label="Toggle menu">
                <i class="bi bi-list"></i>
            </button>

            <!-- Logo/Brand Name with Icon -->
            <a href="#" class="brand-name">
                <i class="bi bi-building-gear"></i>
                <span>PDPias Store</span>
            </a>
        </div>
        <!-- Right Side Items -->
        <div class="d-flex align-items-center">
            <!-- Notification Bell -->
            <a href="#" class="notification-icon" aria-label="Notifications">
                <i class="bi bi-bell"></i>
                <span class="notification-badge">3</span>
            </a>

            <!-- Profile Dropdown -->
            <a href="#"
               class="text-decoration-none dropdown-toggle d-flex justify-content-center align-items-center"
               data-bs-toggle="dropdown"
               aria-expanded="false"
               id="userDropdown"
               aria-haspopup="true">
                <div class="profile-container d-flex">
                    <img src="~/uploads/principal.jpg"
                         alt="Profile"
                         class="profile-img"
                         loading="lazy" />

                </div>
                @{ 
                    var obj = Session["userData"] as principal;
                }

                <span class="profile-name ms-1">@obj.first_name @obj.last_name</span>
            </a>
            <div class="dropdown">

                <ul class="dropdown-menu dropdown-menu-end"
                    aria-labelledby="userDropdown">
                    <li>
                        <a class="dropdown-item" href="#profile-section">
                            <i class="bi bi-person"></i> Profile
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="#">
                            <i class="bi bi-gear"></i> Settings
                        </a>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <!-- Change both logout buttons to use this class -->
                        <a href="#" class="nav-link logout-btn">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Logout</span>
                        </a>
                    </li>
                </ul>

            </div>
        </div>
    </header>


    <!-- Sidebar Navigation -->
    <nav class="sidebar" id="sidebar">
        <ul class="nav-menu">
            <li class="nav-item">
                <a href="@Url.Action("Index","Principal")" class="nav-link">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard Overview</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("ChemicalTracking","Principal")" class="nav-link">
                    <i class="bi bi-flask"></i>
                    <span>Chemical Tracking</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("GlasswareTracking","Principal")" class="nav-link">
                    <i class="bi bi-cup"></i>
                    <span>Glassware Tracking</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("RequestTracking","Principal")" class="nav-link">
                    <i class="bi bi-journal-check"></i>
                    <span>Request Tracking</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("ChemicalDetails","Principal")" class="nav-link">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>Chemical Details</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("GlasswareDetails","Principal")" class="nav-link">
                    <i class="bi bi-file-earmark-break"></i>
                    <span>Glassware Details</span>
                </a>
            </li>

            <!-- Storage with Submenu -->
            <li class="nav-item storage-parent">
                <a href="#!" class="nav-link storage-toggle">
                    <i class="bi bi-box-seam"></i>
                    <span>Stock</span>
                    <i class="bi bi-chevron-down ms-auto small"></i>
                </a>
                <ul class="nav flex-column storage-submenu">
                    <li class="nav-item">
                        <a href="@Url.Action("CurrentChemicalStock", "Principal")" class="nav-link sub-link">
                            - Current Chemical
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("CurrentGlasswareStock", "Principal")" class="nav-link sub-link">
                            - Current Glassware Stock
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("AddStock", "Principal")" class="nav-link sub-link">
                            - Add Stock
                        </a>
                    </li>
                </ul>
            </li>

            <li class="nav-item">
                <a href="@Url.Action("PendingUsers","Principal")" class="nav-link">
                    <i class="bi bi-people"></i>
                    <span>Pending Users</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="@Url.Action("ApprovedUsers","Principal")" class="nav-link">
                    <i class="bi bi-people"></i>
                    <span style="color:green">Approved Users</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="@Url.Action("BlockedUsers","Principal")" class="nav-link">
                    <i class="bi bi-people"></i>
                    <span style="color:red">Blocked Users</span>
                </a>
            </li>


            <li class="nav-item">
                <a href="@Url.Action("Reports","Principal")" class="nav-link">
                    <i class="bi bi-clipboard-data"></i>
                    <span>Reports</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("Profile","Principal")" class="nav-link">
                    <i class="bi bi-person"></i>
                    <span>Profile</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link" id="sidebarLogoutBtn">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logout</span>
                </a>
            </li>
        </ul>
    </nav>


    <div>
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.7.1/dist/chart.min.js"></script>
    @*<script src="~/Scripts/script.js"></script>*@



    <script>
        //for the active class dynamic
        // Get current path (without query string or hash)
        const currentPath = window.location.pathname.toLowerCase();

        // Loop through all sidebar nav links
        document.querySelectorAll('.nav-link').forEach(link => {
            const linkPath = link.getAttribute('href').toLowerCase();

            // If the link path matches the current path, add 'active' class
            if (linkPath === currentPath) {
                link.classList.add('active');
            }
        });
    </script>
    <script>
        // Storage Expand/Collapse Animation
        const storageParent = document.querySelector(".storage-parent");
        const storageToggleBtn = document.querySelector(".storage-toggle");
        const storageSubmenu = document.querySelector(".storage-submenu");

        storageToggleBtn.addEventListener("click", function (e) {
            e.preventDefault();

            if (storageSubmenu.style.height === "0px" || storageSubmenu.style.height === "0") {
                const fullHeight = storageSubmenu.scrollHeight + "px";
                storageSubmenu.style.height = fullHeight;
                storageParent.classList.add("active");
                storageToggleBtn.querySelector(".bi-chevron-down").style.transform = "rotate(180deg)";
            } else {
                storageSubmenu.style.height = "0";
                storageParent.classList.remove("active");
                storageToggleBtn.querySelector(".bi-chevron-down").style.transform = "rotate(0deg)";
            }
        });

        // Nav active class on sub-link click
        document.querySelectorAll(".storage-submenu .nav-link.sub-link").forEach(link => {
            link.addEventListener("click", function () {
                document.querySelectorAll(".storage-submenu .nav-link.sub-link").forEach(l => l.classList.remove("active"));
                this.classList.add("active");
            });
        });

        document.querySelectorAll(".storage-submenu .nav-link.sub-link").forEach(link => {
            link.addEventListener("click", function () {
                document.querySelectorAll(".storage-submenu .nav-link.sub-link").forEach(l => l.classList.remove("active"));
                this.classList.add("active");
            });
        });
    </script>
    
    <script>


        function processUser(id, role, action) {
            var url = "~/Principal/ChangeState";

            const postData = {
                id: id, // Pass ID as string
                role: role,
                status: action
            };

            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    
                },
                body: JSON.stringify(postData)
            })
                .then(data => {
                    if (data.success) {
                        alert('User status updated successfully.');
                        // Reload the current page to refresh the user list
                        window.location.reload();
                    }
            })
        }

    </script>

</body>
</html>
