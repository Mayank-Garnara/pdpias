@model List<PDPIAS_STORE.Models.labTech.notificationModel>
@{
    Layout = "~/VieWs/Shared/lebTech_Dashbord.cshtml";
    ViewBag.Title = "Index";
}


<style>
    :root {
        --glass-bg: rgba(255, 255, 255, 0.9);
        --neomorphic-shadow: 20px 20px 60px #d9d9d9, -20px -20px 60px #ffffff;
        --accent-color: #6366f1;
    }

    .card-glass-hover {
        background: var(--glass-bg);
        backdrop-filter: blur(12px);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        box-shadow: var(--neomorphic-shadow);
        transition: all 0.3s ease;
        min-height: 260px;
    }

        .card-glass-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1);
        }

/*    .icon-wrapper {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }*/

    .progress-neomorphic {
        height: 10px;
        background: rgba(241, 243, 245, 0.8);
        border-radius: 8px;
        overflow: hidden;
        position: relative;
    }

    .progress-bar {
        height: 100%;
        position: relative;
        transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .progress-wave {
        position: absolute;
        width: 200%;
        height: 100%;
        background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.3) 50%, rgba(255,255,255,0) 100%);
        animation: wave 2s infinite linear;
    }

    .detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        background: rgba(241, 243, 245, 0.4);
        padding: 12px;
        border-radius: 12px;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
    }

    .detail-label {
        font-size: 0.8em;
        color: #6c757d;
    }

    .detail-value {
        font-weight: 600;
        color: var(--accent-color);
    }

    .status-indicator {
        padding: 6px 12px;
        font-size: 0.75em;
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255,255,255,0.2);
    }

    .bg-success-glow {
        background: rgba(40, 167, 69, 0.15);
        color: #28a745;
        box-shadow: 0 0 8px rgba(40, 167, 69, 0.3);
    }

    .bg-danger-pulse {
        background: rgba(220, 53, 69, 0.15);
        color: #dc3545;
        animation: pulse 1.5s infinite;
    }

    @@keyframes wave {
        0% {
            transform: translateX(-50%);
        }

        100% {
            transform: translateX(50%);
        }
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(220,53,69,0.3);
        }

        70% {
            box-shadow: 0 0 0 8px rgba(220,53,69,0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(220,53,69,0);
        }
    }

    .btn-soft-primary {
        background: rgba(99, 102, 241, 0.1);
        border: 1px solid rgba(99, 102, 241, 0.2);
        color: #6366f1;
        transition: all 0.3s ease;
    }

        .btn-soft-primary:hover {
            background: rgba(99, 102, 241, 0.2);
        }
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<main class="main-content" id="mainContent">
    <section id="chemical-details-section" class="content-section">
        <div class="page-header">
            <h1 class="page-title">Notification / Alerts</h1>
            <div>
                <!-- Existing buttons commented out -->
            </div>
        </div>

        <div class="col-lg-6 fade-in" style="animation-delay: 0.3s">
            <div class="card">
                <div class="card-header">
                    <span>🔔 New Chemical/Glassware Order Status</span>
                    <a href="#request-tracking-section" class="btn btn-sm btn-link">View All</a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover table-sm">
                            <thead>
                                <tr>
                                    <th>cas no</th>
                                    <th>chemical Name</th>
                                    <th>Status</th>
                                    <th>Approved By</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.casNo</td>
                                        <td>@item.chemicalName</td>
                                        <td>
                                            @if(item.Status == "pending"){
                                                <span class="badge badge-pending">@item.Status</span>
                                            }else if(@item.Status == "approved"){
                                                <span class="badge badge-approved">@item.Status</span>
                                            } else{
                                                <span class="badge badge-rejected">@item.Status</span>
                                            }
                                        </td>
                                        <td>@item.ApprovedBy</td>
                                        <td>
                                            @item.Date
                                        </td>
                                    </tr>
                                }

                            
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <span>🔔 Low Stock Alerts</span>
                    </div>
                    <div class="card-body">
                        <div class="row">

                            @foreach (var item in Model)
                            {
                                <div class="col-md-6 col-lg-3 mb-4">
                                    <div class="card-glass-hover position-relative overflow-hidden">
                                        <div class="card-blur-layer"></div>

                                        <!-- Status Ribbon -->
                                        <div class="position-absolute top-0 end-0 p-2">
                                            <div class="status-indicator @(item.Stock == "high stock" ? "bg-success-glow" : "bg-danger-pulse") rounded-pill">
                                                <i class="@(item.Stock == "high stock" ? "fas fa-chart-line" : "fas fa-exclamation") me-1"></i>
                                                @item.Stock
                                            </div>
                                        </div>

                                        <div class="card-body position-relative">
                                            <!-- Item Icon -->
                                            <div class="icon-wrapper bg-@(item.Stock == "high stock" ? "success" : "danger")-gradient mb-3">
                                                <i class="fas fa-@(item.ItemType.ToLower() == "medicine" ? "capsules" : "box-open") text-white"></i>
                                            </div>

                                            <!-- Main Content -->
                                            <h3 class="card-title fw-800 mb-3">@item.ItemName</h3>

                                            <!-- Stock Meter -->
                                            <div class="stock-meter mb-4">
                                                @*<div class="d-flex justify-content-between mb-2">*@
                                                    <!--<span class="text-small">Stock Level</span>
                                                    <span class="text-accent">-->
                                                        @*@item.CurrentStock/@item.MinimumRequired*@
                                                        <!--@item.Stock
                                                    </span>-->
                                                @*</div>*@
                                                <div class="progress-neomorphic">
                                                    @{
//var progress = Math.Min((double)item.CurrentStock / item.MinimumRequired * 100, 100);
//var progressClass = progress >= 150 ? "bg-success" :
//progress >= 100 ? "bg-warning" : "bg-danger";
                                                    }
                                                    @*<div class="progress-bar @progressClass"
                                                         style="width: @progress%;"
                                                         role="progressbar">
                                                        <div class="progress-wave"></div>
                                                    </div>*@
                                                </div>
                                            </div>

                                            <!-- Details Grid -->
                                            <div class="detail-grid">
                                                <div class="detail-item">
                                                    <span class="detail-label">Type</span>
                                                    <span class="detail-value">@item.ItemType</span>
                                                </div>
                                                <div class="detail-item">
                                                    <span class="detail-label">Last Restock</span>
                                                    <span class="detail-value">@DateTime.Now.AddDays(-2).ToString("dd MMM")</span>
                                                </div>
                                            </div>

                                            <!-- Action Buttons -->
                                            @*<div class="d-flex gap-2 mt-4">
                                                <button class="btn btn-sm btn-soft-primary flex-fill">
                                                    <i class="fas fa-history me-2"></i>History
                                                </button>
                                                <button class="btn btn-sm btn-soft-success flex-fill">
                                                    <i class="fas fa-cart-plus me-2"></i>Order
                                                </button>
                                            </div>*@
                                        </div>
                                    </div>
                                </div>
                            }


                        </div>
                    </div>


                </div>
            </div>
        </div>






