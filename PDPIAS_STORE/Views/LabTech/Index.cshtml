                                                        aria-valuenow="50"
                                                        aria-valuemin="0"
                                                        aria-valuemax="100">
                                                        <div class="progress-sparkle"></div>
                                                    </div>
                                                </div>*@
                                            </div>
                                            <!-- Action Buttons -->
                                            <div class="d-grid gap-2 d-md-flex justify-content-between">
