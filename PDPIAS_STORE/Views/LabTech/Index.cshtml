                                                </button>
                                                <button class="btn btn-outline-danger btn-hover-scale px-4 py-2 border-2">
                                                    <i class="bi bi-clipboard-data me-2"></i>Details
                                                </button>
                                            </div>
                                        </div>
                                        <!-- Card Footer with time indicator -->
                                        <div class="card-footer bg-danger-05 py-2">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <small class="text-danger text-glow">
                                                    <i class="bi bi-clock-history me-1"></i>
                                                    Last ordered: 3 days ago
                                                </small>
                                                <div class="timeline-indicator bg-danger pulse-slow"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts and Quick Actions Row -->
        @*
        *  Add here just link over here
