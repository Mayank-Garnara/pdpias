        <!--  Return/Used Chemical (Entry Modal) -->
        <!-- Return / Used Chemical Entry Modal -->
        <div class="modal fade" id="chemicalEntryModal" tabindex="-1" aria-labelledby="chemicalEntryLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">

                    <!-- Modal Header -->
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title" id="chemicalEntryLabel">Return / Used Chemical Entry</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <!-- Modal Body -->
                    <div class="modal-body">
                        <form id="chemicalEntryForm">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="chemicalName" class="form-label">Chemical Name</label>
                                    <input type="text" class="form-control" id="chemicalName" name="chemicalName" placeholder="Enter chemical name">
                                </div>
                                <div class="col-md-6">
                                    <label for="chemicalId" class="form-label">Chemical ID / CAS No.</label>
                                    <input type="text" class="form-control" id="chemicalId" name="chemicalId" placeholder="Enter ID or CAS No.">
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="quantityUsed" class="form-label">Quantity Used</label>
                                    <input type="number" step="any" class="form-control" id="quantityUsed" name="quantityUsed" placeholder="Enter used quantity">
                                </div>
                                <div class="col-md-6">
                                    <label for="unit" class="form-label">Unit</label>
                                    <select class="form-select" id="unit" name="unit">
                                        <option value="g">Grams (g)</option>
                                        <option value="ml">Milliliters (mL)</option>
                                    </select>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="remainingQuantity" class="form-label">Remaining Quantity (optional)</label>
                                <input type="number" step="any" class="form-control" id="remainingQuantity" name="remainingQuantity" placeholder="Enter remaining quantity if known">
                            </div>

                            <div class="mb-3">
                                <label for="entryType" class="form-label">Entry Type</label>
                                <select class="form-select" id="entryType" name="entryType">
                                    <option value="used">Used</option>
                                    <option value="returned">Returned</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="remarks" class="form-label">Remarks</label>
                                <textarea class="form-control" id="remarks" name="remarks" rows="3" placeholder="Enter any remarks or purpose of use"></textarea>
                            </div>
                        </form>
                    </div>

                    <!-- Modal Footer -->
                    <div class="modal-footer">
                        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" form="chemicalEntryForm" class="btn btn-success">Submit Entry</button>
                    </div>
                </div>
            </div>
        </div>



