@model PDPIAS_STORE.Models.labTech.LabTechDashboardViewModel

@{
    Layout = "~/Views/Shared/lebTech_Dashbord.cshtml";
    ViewBag.Title = "Lab Technician Dashboard";
}



<style>
    .custom-stock-card {
        border-radius: 20px;
        transition: all 0.3s ease;
        background: linear-gradient(145deg, #ffffff 0%, #f8f9fa 100%);
    }

    .neon-hover:hover {
        box-shadow: 0 0 25px rgba(255, 0, 0, 0.2);
        transform: translateY(-5px);
    }

    .bg-danger-gradient-pulse {
        background: linear-gradient(135deg, #ff4444 0%, #dc3545 100%);
        animation: gradientPulse 2s infinite;
    }

    .border-bottom-dashed {
        border-bottom: 2px dashed rgba(0,0,0,0.1);
    }

    .floating-icon {
        position: absolute;
        opacity: 0.1;
        font-size: 8rem;
        right: -30px;
        top: -30px;
        color: #dc3545;
    }

    .drip-animation {
        animation: drip 4s infinite;
    }

    .progress-sparkle {
        position: absolute;
        right: 0;
        width: 20px;
        height: 100%;
        background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.4) 100%);
        animation: sparkle 1.5s infinite;
    }

    .btn-icon-animate {
        transition: transform 0.3s ease;
    }

    .gradient-hover:hover {
        background: linear-gradient(45deg, #dc3545, #ff4444);
        box-shadow: 0 5px 15px rgba(220,53,69,0.4);
    }

    @@keyframes sparkle {
        0% {
            opacity: 0;
            right: -20px;
        }

        50% {
            opacity: 1;
        }

        100% {
            opacity: 0;
            right: 100%;
        }
    }

    @@keyframes drip {
        0% {
            transform: translateY(0) scale(1);
        }

        50% {
            transform: translateY(20px) scale(1.1);
        }

        100% {
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes gradientPulse {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    .pulse {
        animation: textPulse 1.5s infinite;
    }

    @@keyframes textPulse {
        0% {
            opacity: 1;
        }

        50% {
            opacity: 0.5;
        }

        100% {
            opacity: 1;
        }
    }

    .border-animation.shimmer {
        background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.2) 50%, transparent 100% );
        animation: shimmer 3s infinite;
    }

    @@keyframes shimmer {
        0% {
            transform: translateX(-100%);
        }

        100% {
            transform: translateX(100%);
        }
    }
</style>


<main class="main-content" id="mainContent">
    <!-- Dashboard Overview Section -->
    <section id="dashboard-section" class="content-section">
        <div class="page-header">
            <h1 class="page-title">Lab Technician Dashboard Overview</h1>
            @*<div>
                <button class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-download me-1"></i> Export
                </button>
            </div>*@
        </div>

        @*<p class="page-description">
            Welcome back, Principal. Here's what's happening with your lab
            inventory today.
        </p>*@

        <!-- Issued Chemical History -- (table) -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <span>Issued Chemical History</span>
                    </div>

                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="text-center">
                                    <tr>
                                        <th class="text-center">Chemical Id<br><input type="text" onkeyup="filterColumn(1)" placeholder="Search Id"></th>
                                        <th class="text-center">Chemical Name<br><input type="text" onkeyup="filterColumn(2)" placeholder="Search Name"></th>
                                        <th class="text-center">Quantity<br><input type="text" onkeyup="filterColumn(5)" placeholder="Search Qty"></th>
                                        <th class="text-center">Supplier<br><input type="text" onkeyup="filterColumn(6)" placeholder="Search Supplier"></th>
                                        <th class="text-center">Order No<br><input type="text" onkeyup="filterColumn(7)" placeholder="Search Order No"></th>
                                        <th class="text-center">Order Date<br><input type="text" onkeyup="filterColumn(8)" placeholder="Search Order Date"></th>
                                        <th class="text-center">Expiry Date<br><input type="text" onkeyup="filterColumn(9)" placeholder="Search Expiry"></th>
                                        <th class="text-center">Status<br><input type="text" onkeyup="filterColumn(12)" placeholder="Search Status"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.IssuedChemicalHistories)
                                    {
                                        <tr>

                                            <td>@item.ChemicalId</td>
                                            <td>@item.ChemicalName</td>
                                            <td>@item.Quantity</td>
                                            <td>@item.Supplier</td>
                                            <td>@item.OrderNo</td>
                                            <td>@item.OrderDate</td>
                                            <td>@item.ExpiryDate</td>
                                            <td>
                                                @if (item.Status == "Pending")
                                                {
                                                    <span class="badge badge-pending">Pending</span>
                                                }
                                                else if (item.Status == "approve")
                                                {
                                                    <span class="badge badge-approved">approved</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-rejected">rejected</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>




        <!-- Department-wise Stats -->
