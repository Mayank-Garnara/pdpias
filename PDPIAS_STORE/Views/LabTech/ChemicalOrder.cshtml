<style>
    .table-wrapper {
        max-height: 600px;
        overflow-y: auto;
        overflow-x: auto;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
        border-radius: 12px;
    }

    thead th {
        position: sticky;
        top: 0;
        background-color: #f8f9fa;
        z-index: 1;
        vertical-align: middle;
    }

    th input {
        width: 100%;
        padding: 2px 6px;
        font-size: 12px;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    .table-hover tbody tr:hover {
        background-color: #f1f1f1;
    }

    .table th, .table td {
        white-space: nowrap;
        vertical-align: middle;
    }

    th, td {
        text-align: center;
        vertical-align: middle;
    }

    th input {
        text-align: center;
    }


</style>

