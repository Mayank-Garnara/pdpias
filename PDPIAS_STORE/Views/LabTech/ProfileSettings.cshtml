@model PDPIAS_STORE.Models.labTech.indexViewLtModel
@{
    Layout = "~/VieWs/Shared/lebTech_Dashbord.cshtml";
    ViewBag.Title = "Index";
}

<style>
    .gradient-text {
        background: linear-gradient(45deg, #2c3e50, #3498db);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .profile-image-container:hover img {
        transform: scale(1.05);
    }

    .hover-item:hover {
        background: linear-gradient(45deg, #f8f9fa, #e9ecef);
        transform: translateX(5px);
        transition: all 0.3s ease;
    }

    .active-item {
        background: linear-gradient(45deg, #3498db, #2c3e50) !important;
        border-color: transparent !important;
        color: white !important;
    }

    .hover-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.1);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .profile-image-container:hover .hover-overlay {
        opacity: 1;
    }

    .hover-gradient:hover {
        background: linear-gradient(45deg, #e3f2fd, #bbdefb);
        border-color: #3498db !important;
    }
</style>

<!-- Add Font Awesome for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<main class="main-content" id="mainContent">
    <section id="profile-section"
             class="content-section">
        <div class="page-header">
            <h1 class="page-title">My Profile</h1>
        </div>

        <div class="row">

            <div class="col-lg-4">
                <div class="card shadow border-0">
                    <div class="card-body text-center py-4">
                        <figure class="mb-4">
                            <div class="profile-image-container position-relative d-inline-block">
                                <img src="D:\Kayan2.jpg"
                                     alt="Profile"
                                     class="rounded-circle mb-3 shadow-sm"
                                     width="150"
                                     height="150"
                                     style="object-fit: cover; transition: transform 0.3s ease;">
                                <div class="hover-overlay rounded-circle"></div>
                            </div>
                            <figcaption class="h3 fw-bold mt-2 gradient-text">
                                Dr. Kavit Bokarvadiya
                            </figcaption>
                            <p class="text-uppercase text-primary mb-4 fw-medium">Principal</p>
                        </figure>

                        <div class="d-flex justify-content-center mb-4 gap-2">
                            <button class="btn btn-primary rounded-pill px-4 py-2 d-flex align-items-center"
                                    data-bs-toggle="modal"
                                    data-bs-target="#changePhotoModal">
                                <i class="fas fa-camera me-2"></i> Change Photo
                            </button>
                            <button class="btn btn-light border rounded-pill px-4 py-2 d-flex align-items-center hover-gradient">
                                <i class="fas fa-download me-2 text-primary"></i> Download
                            </button>
                        </div>

                        <div class="list-group list-group-flush border-top border-bottom">
                            <a href="#profile-info"
                               class="list-group-item list-group-item-action d-flex align-items-center active-item">
                                <i class="fas fa-user-circle me-3 fs-5"></i>
                                <span class="fw-medium">Personal Information</span>
                            </a>
                            <a href="#profile-security"
                               class="list-group-item list-group-item-action d-flex align-items-center hover-item">
                                <i class="fas fa-shield-alt me-3 fs-5"></i>
                                <span class="fw-medium">Account Security</span>
                            </a>
                            <a href="#profile-notifications"
                               class="list-group-item list-group-item-action d-flex align-items-center hover-item">
                                <i class="fas fa-bell me-3 fs-5"></i>
                                <span class="fw-medium">Notification Settings</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

