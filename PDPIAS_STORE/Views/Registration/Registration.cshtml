@model PDPIAS_management.Models.Person.ViewModelWrapper
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registration</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="~/style/registrationStyle.css">
</head>
<body>
    <div class="d-flex align-items-start">
        <div class="nav flex-column nav-pills me-3"
             id="v-pills-tab"
             role="tablist"
             aria-orientation="vertical">
            <button class="nav-link active"
                    id="v-pills-home-tab"
                    data-bs-toggle="pill"
                    data-bs-target="#v-pills-home"
                    type="button"
                    role="tab"
                    aria-controls="v-pills-home"
                    aria-selected="true">
                <b>🧪 Lab Technician </b><br />
                <small>Laboratory Management Access</small>
            </button>
            <button class="nav-link"
                    id="v-pills-profile-tab"
                    data-bs-toggle="pill"
                    data-bs-target="#v-pills-profile"
                    type="button"
                    role="tab"
                    aria-controls="v-pills-profile"
                    aria-selected="false">
                <b>🏬 Store Manager</b><br>
                <small>Chemical Inventory Control</small>
            </button>
            <button class="nav-link"
                    id="v-pills-disabled-tab"
                    data-bs-toggle="pill"
                    data-bs-target="#v-pills-disabled"
                    type="button"
                    role="tab"
                    aria-controls="v-pills-disabled"
                    aria-selected="false">
                <b>🏢 Department Head</b><br>
                <small>Department Administration</small>
            </button>
        </div>

        <div class="tab-content" id="v-pills-tabContent">
            <div class="tab-pane fade show active"
                 id="v-pills-home"
                 role="tabpanel"
                 aria-labelledby="v-pills-home-tab"
                 tabindex="0">
                <!-- Form Section -->
                <div class="form-panel" id="formPanel">
                    <div class="form-header">
                        <h2 class="form-title">
                            Register as <span id="selectedRole">🧪 Lab Technician</span>
                        </h2>
                    </div>
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    @using (Html.BeginForm("RegisterLabTechnician", "Registration", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()

                        <!-- Common Fields for All Roles -->
                        <div class="two-column-group">
                            <div class="form-group">
                                @Html.TextBoxFor(m => m.LabTechnician.FirstName, new { @class = "input-field", placeholder = "First Name", required = "required" })
                                @Html.ValidationMessageFor(m => m.LabTechnician.FirstName, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                @Html.TextBoxFor(m => m.LabTechnician.LastName, new { @class = "input-field", placeholder = "Last Name", required = "required" })
                                @Html.ValidationMessageFor(m => m.LabTechnician.LastName, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.TextBoxFor(m => m.LabTechnician.Email, new { @class = "input-field", type = "email", placeholder = "Email Address", required = "required" })
                            @Html.ValidationMessageFor(m => m.LabTechnician.Email, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.TextBoxFor(m => m.LabTechnician.ContactNo, new { @class = "input-field", type = "tel", placeholder = "Contact Number", pattern = "[0-9]{10}", required = "required" })
                            @Html.ValidationMessageFor(m => m.LabTechnician.ContactNo, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group" id="departmentGroup">
                            @Html.DropDownListFor(
                                m => m.LabTechnician.department_id,// <-- bind to model property
                                (List<SelectListItem>)ViewBag.Departments,// <-- the list you stored
                                "Select Department",                // <-- optional first item
                                new { @class = "form-control" }// <-- any HTML attributes you want
                               )
                            @Html.ValidationMessageFor(m => m.LabTechnician.department_id, "", new { @class = "text-danger" })
                        </div>

                        <!-- Profile Picture Upload -->
                        <div class="form-group" id="profileUploadGroup">
                            <label class="upload-label">
                                <span>Profile Picture</span>
                                @Html.TextBoxFor(m => m.LabTechnician.ProfilePic, new { type = "file", accept = "image/*", @class = "profile-picture" })
                                <div class="upload-preview" id="uploadPreview-lab">
                                    <i class="fas fa-user-circle"></i>
                                    <span>Click to upload</span>
                                </div>
                            </label>
                        </div>

                        <!-- Password Fields -->
                        <div class="two-column-group">
                            <div class="form-group">
                                @Html.PasswordFor(m => m.LabTechnician.Password, new { @class = "input-field password-input", placeholder = "Password", required = "required" })
                                @Html.ValidationMessageFor(m => m.LabTechnician.Password, "", new { @class = "text-danger" })
                                <div class="password-strength">
                                    <div class="strength-bar"></div>
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.PasswordFor(m => m.LabTechnician.ConfirmPassword, new { @class = "input-field", placeholder = "Confirm Password", required = "required" })
                                @Html.ValidationMessageFor(m => m.LabTechnician.ConfirmPassword, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-primary submit-btn">
                                Complete Registration
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="tab-pane fade"
                 id="v-pills-profile"
                 role="tabpanel"
                 aria-labelledby="v-pills-profile-tab"
                 tabindex="0">
                <div class="form-panel" id="formPanel">
                    <div class="form-header">
                        <h2 class="form-title">
                            Register as <span id="selectedRole">🏬 Store Manager</span>
                        </h2>
                    </div>

                    @using (Html.BeginForm("RegisterHeadStoreManager", "Registration", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        <div class="two-column-group">
                            <div class="form-group">
                                @Html.TextBoxFor(m => m.HeadStore.FirstName, new { @class = "input-field", placeholder = "First Name", required = "required" })
                                @Html.ValidationMessageFor(m => m.HeadStore.FirstName, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                @Html.TextBoxFor(m => m.HeadStore.LastName, new { @class = "input-field", placeholder = "Last Name", required = "required" })
                                @Html.ValidationMessageFor(m => m.HeadStore.LastName, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.TextBoxFor(m => m.HeadStore.Email, new { @class = "input-field", type = "email", placeholder = "Email Address", required = "required" })
                            @Html.ValidationMessageFor(m => m.HeadStore.Email, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.TextBoxFor(m => m.HeadStore.ContactNo, new { @class = "input-field", type = "tel", placeholder = "Contact Number", pattern = "[0-9]{10}", required = "required" })
                            @Html.ValidationMessageFor(m => m.HeadStore.ContactNo, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group" id="profileUploadGroup">
                            <label class="upload-label">
                                <span>Profile Picture</span>
                                @Html.TextBoxFor(m => m.HeadStore.ProfilePic, new { type = "file", accept = "image/*", @class = "profile-picture" })

                                <div class="upload-preview" id="uploadPreview-store">
                                    <i class="fas fa-user-circle"></i>
                                    <span>Click to upload</span>
                                </div>
                            </label>
                        </div>

                        <div class="two-column-group">
                            <div class="form-group">
                                @Html.PasswordFor(m => m.HeadStore.Password, new { @class = "input-field password-input", placeholder = "Password", required = "required" })
                                @Html.ValidationMessageFor(m => m.HeadStore.Password, "", new { @class = "text-danger" })
                                <div class="password-strength">
                                    <div class="strength-bar"></div>
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.PasswordFor(m => m.HeadStore.ConfirmPassword, new { @class = "input-field", placeholder = "Confirm Password", required = "required" })
                                @Html.ValidationMessageFor(m => m.HeadStore.ConfirmPassword, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-primary submit-btn">
                                Complete Registration
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="tab-pane fade"
                 id="v-pills-disabled"
                 role="tabpanel"
                 aria-labelledby="v-pills-disabled-tab"
                 tabindex="0">
                <div class="form-panel" id="formPanel">
                    <div class="form-header">
                        <h2 class="form-title">
                            Register as <span id="selectedRole">🏢 Department Head</span>
                        </h2>
                    </div>

                    @using (Html.BeginForm("RegisterHead", "Registration", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        <div class="two-column-group">
                            <div class="form-group">
                                @Html.TextBoxFor(m => m.DepartmentHead.FirstName, new { @class = "input-field", placeholder = "First Name", required = "required" })
                                @Html.ValidationMessageFor(m => m.DepartmentHead.FirstName, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                @Html.TextBoxFor(m => m.DepartmentHead.LastName, new { @class = "input-field", placeholder = "Last Name", required = "required" })
                                @Html.ValidationMessageFor(m => m.DepartmentHead.LastName, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.TextBoxFor(m => m.DepartmentHead.Email, new { @class = "input-field", type = "email", placeholder = "Email Address", required = "required" })
                            @Html.ValidationMessageFor(m => m.DepartmentHead.Email, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.TextBoxFor(m => m.DepartmentHead.ContactNo, new { @class = "input-field", type = "tel", placeholder = "Contact Number", pattern = "[0-9]{10}", required = "required" })
                            @Html.ValidationMessageFor(m => m.DepartmentHead.ContactNo, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group" id="departmentGroup">
                            @Html.DropDownListFor(
                                m => m.DepartmentHead.DepartmentId,                     // <-- bind to model property
                                (List<SelectListItem>)ViewBag.Departments, // <-- the list you stored
                                "Select Department",                      // <-- optional first item
                                new { @class = "form-control input-field" }            // <-- any HTML attributes you want
)
                            @Html.ValidationMessageFor(m => m.DepartmentHead.DepartmentId, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group" id="profileUploadGroup">
                            <label class="upload-label">
                                <span>Profile Picture</span>
                                @Html.TextBoxFor(m => m.DepartmentHead.ProfilePic, new { type = "file", accept = "image/*", @class = "profile-picture" })
                                <div class="upload-preview" id="uploadPreview-dept">
                                    <i class="fas fa-user-circle"></i>
                                    <span>Click to upload</span>
                                </div>
                            </label>
                        </div>

                        <div class="two-column-group">
                            <div class="form-group">
                                @Html.PasswordFor(m => m.DepartmentHead.Password, new { @class = "input-field password-input", placeholder = "Password", required = "required" })
                                @Html.ValidationMessageFor(m => m.DepartmentHead.Password, "", new { @class = "text-danger" })
                                <div class="password-strength">
                                    <div class="strength-bar"></div>
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.PasswordFor(m => m.DepartmentHead.ConfirmPassword, new { @class = "input-field", placeholder = "Confirm Password", required = "required" })
                                @Html.ValidationMessageFor(m => m.DepartmentHead.ConfirmPassword, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-primary submit-btn">
                                Register
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <script src="~/script/registrationJs.js"></script>
    @Html.Raw("<script src='https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js' integrity='sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r' crossorigin='anonymous'></script>")
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.min.js"
            integrity="sha384-VQqxDN0EQCkWoxt/0vsQvZswzTHUVOImccYmSyhJTp7kGtPed0Qcx8rK9h9YEgx+"
            crossorigin="anonymous"></script>
</body>
</html>

<script>
    let labTechnician = document.getElementById("v-pills-home-tab");
    let storeManager = document.getElementById("v-pills-profile-tab");
    let departmentHead = document.getElementById("v-pills-disabled-tab");

    window.onload = function () {
        @if (ViewBag.Tab == "DepartmentHead")
        {
            <text>departmentHead.click();</text>
        }
        else if (ViewBag.Tab == "StoreManager")
        {
            <text>storeManager.click();</text>
        }
        else if (ViewBag.Tab == "LabTechnician")
        {
            <text>labTechnician.click();</text>
        }
    };
</script>

